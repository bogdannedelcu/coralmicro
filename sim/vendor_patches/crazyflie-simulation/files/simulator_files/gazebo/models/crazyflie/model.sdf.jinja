        <!-- DISABLED 2026-05-17 — anti-cheat ([[cf2-sitl-cheat-odom-gt]]).
             Re-applied 2026-05-22 after iter-85+ TOF-injection backout (s190).
             This plugin publishes Gazebo GT pose on /cf_X/odom; OdomCallback
             in crazysim_plugin.cpp forwards it as CrtpExtPose → cf2 EKF gets
             perfect pose, masking real drift.  Backup of original:
             model.sdf.jinja.pre_no_cheat_20260517.
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <dimensions>3</dimensions>
            <odom_publish_frequency>200</odom_publish_frequency>
            <odom_topic>/cf_{{ cf_id }}/odom</odom_topic>
        </plugin>
        -->
        <plugin
            filename="gz_crazysim_plugin"
            name="crazyflie_interface::GzCrazyflieInterface">
            <imuSubTopic>/imu</imuSubTopic>
            <magSubTopic>/mag</magSubTopic>
            <baroSubTopic>/baro</baroSubTopic>
            <cffirm_addr>INADDR_ANY</cffirm_addr>
            <cffirm_port>{{ cffirm_udp_port }}</cffirm_port>
            <cflib_addr>INADDR_ANY</cflib_addr>
            <cflib_port>{{ cflib_udp_port }}</cflib_port>
            <cfPrefix>{{ cf_name }}</cfPrefix>
            <cfId>{{ cf_id }}</cfId>
        </plugin>
