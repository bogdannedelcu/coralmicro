+                 * before fill-start).  Hook writes that cam_id to
+                 * g_cam_buf_id[slot] in camera_support.c, providing
+                 * a synthetic per-buffer fingerprint independent of
+                 * scene content.  Weak default keeps SDK clean for
+                 * non-coralmicro builds. */
+                extern void coralmicro_csi_on_buffer_arm(uint32_t addr);
+                coralmicro_csi_on_buffer_arm(emptyBuf);
             }
