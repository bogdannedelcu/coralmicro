@@ -888,6 +888,16 @@ void CSI_TransferHandleIRQ(CSI_Type *base, csi_handle_t *handle)
                 frameBuffer                             = CSI_GetRxBufferAddr(base, dmaDoneBufferIdx);
                 handle->frameBufferQueue[queueWriteIdx] = frameBuffer;
 
+                /* sentai 2026-04-26: authoritative per-buffer source-camera
+                 * tagging hook.  Called HERE — the only point where the
+                 * NXP driver itself confirms a real (non-spurious) frame
