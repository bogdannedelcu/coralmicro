+         * pclkPeriod scales inversely with lane bit rate:
+         *   0x14 × (56/84) = 13.33 ≈ 0x0D  */
+        .resolution  = (uint32_t)kVIDEO_ResolutionVGA,
+        .framePerSec = 45,
+        .pllCtrl1    = 0x14,
+        .pllCtrl2    = 0x54,
+        .vfifoCtrl0C = 0x22,
+        .pclkDiv     = 0x02,
+        .pclkPeriod  = 0x0D,
     },
