diff --git a/components/video/camera/device/ov5640/fsl_ov5640.c b/components/video/camera/device/ov5640/fsl_ov5640.c
index d875caf8..d3c8b35f 100644
--- a/components/video/camera/device/ov5640/fsl_ov5640.c
+++ b/components/video/camera/device/ov5640/fsl_ov5640.c
@@ -653,6 +653,23 @@ static const ov5640_clock_config_t s_ov5640MipiClockConfigs[] = {
         .pclkDiv     = 0x04,
         .pclkPeriod  = 0x0a,
     },
+    {
+        /* sentai 2026-11-01 (EXP-s260): the row above was cloned from 720P/30
+         * but the 1280x960 frame has 984 lines (VTS) instead of 720p's ~740,
+         * so the CSI frame counter measures 22.6 fps, not 30.  Frame rate is
+         * proportional to PLL mult / (sysdiv x mipi_div): keep sysdiv 2 /
+         * mipi_div 1 and raise the multiplier 84 -> 112 (0x70, PLL 896 MHz, the
+         * same PLL the VGA/60 row runs) for a true 30 fps.  Keyed on 36 so
+         * the legacy 30 row stays as measured elsewhere.  pclkPeriod scaled
+         * 0x0a x 84/112 = 0x08. */
+        .resolution  = FSL_VIDEO_RESOLUTION(1280, 960),
+        .framePerSec = 36,
+        .pllCtrl1    = 0x21,
+        .pllCtrl2    = 0x70,
+        .vfifoCtrl0C = 0x20,
+        .pclkDiv     = 0x04,
+        .pclkPeriod  = 0x08,
+    },
 };
 
