// Provisional SentAI/MIMXRT1176 CM7 Renode platform.
//
// This is a B8 bring-up scaffold, not a complete EVK model.  The memory map
// follows examples/sentai_runtime/MIMXRT1176xxxxx_cm7_ram_mp.ld and the UART
// follows third_party/modified/nxp/rt1176-sdk/board.h.

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 528000000
    priorityMask: 0xF0
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    nvic: nvic
    numberOfMPURegions: 16

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 792000000

// ITCM/DTCM/OCRAM/SDRAM regions required by the RAM linker script.
itcm: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x80000

dtcm: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000

ocram: Memory.MappedMemory @ sysbus 0x20200000
    size: 0x200000

sdram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x4000000

// SentAI debug console is LPUART6 on the modified Coral/NXP board config.
lpuart6: UART.NXP_LPUART @ sysbus 0x40090000
    IRQ -> nvic@25

// Early SDK boot MMIO.  These stubs let us discover the next real modeling
// boundary without failing on unmapped access noise.
wdog1: Python.PythonPeripheral @ sysbus 0x40030000
    size: 0x4000
    initable: true
    filename: "scripts/pydev/ticker.py"

