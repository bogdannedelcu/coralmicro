:name: SentAI B8.8 P4a EdgeTPU OpenDevice no-device probe
:description: Boot the EdgeTPU OpenDevice probe target.  This starts UsbHostTask, EdgeTpuManager, and EdgeTpuTask, then calls EdgeTpuManager::OpenDevice() from a FreeRTOS task with a pre-marked USB error/no-device condition.  The expected result is nullptr plus a live scheduler heartbeat.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_edgetpu_opendevice_probe
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_edgetpu_opendevice_probe.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

emulation RunFor "3s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_edgetpu_opendevice_probe PC:"
cpu PC
echo "sentai_emu_edgetpu_opendevice_probe boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_edgetpu_opendevice_probe step:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_step"`
echo "sentai_emu_edgetpu_opendevice_probe heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_edgetpu_opendevice_probe last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
