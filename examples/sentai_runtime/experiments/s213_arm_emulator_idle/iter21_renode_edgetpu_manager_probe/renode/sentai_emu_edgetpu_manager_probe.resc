:name: SentAI B8.8 P3a EdgeTPU manager probe smoke
:description: Boot the EdgeTPU-manager probe target.  This starts the production UsbHostTask as in B8.8 P2, constructs the production EdgeTpuManager singleton, then starts the ARM FreeRTOS scheduler with a lower-priority heartbeat.  It intentionally does not call EdgeTpuManager::OpenDevice() yet.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_edgetpu_manager_probe
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_edgetpu_manager_probe.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

emulation RunFor "3s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_edgetpu_manager_probe PC:"
cpu PC
echo "sentai_emu_edgetpu_manager_probe boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_edgetpu_manager_probe step:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_step"`
echo "sentai_emu_edgetpu_manager_probe heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_edgetpu_manager_probe last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
