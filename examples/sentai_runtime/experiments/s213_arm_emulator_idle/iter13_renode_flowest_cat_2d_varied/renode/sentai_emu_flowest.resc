:name: SentAI B8.7d ARM Flow-offset detection with 2D varied motion
:description: Boots sentai_emu_flowest and drives 6 cat scenes with varied 2D offsets through g_frame_buffer using `sysbus LoadBinary`.  Per-frame absolute offsets (X, Y): (0,0), (+2,0), (+2,+2), (-1,+1), (-1,-2), (+3,-2).  Expected detected per-frame motion deltas: (0,0) prime, (+2,0), (0,+2), (-3,-1), (0,-3), (+4,0).  Mixes pure-X, pure-Y, diagonal-negative, diagonal-positive moves to ensure the SAD block matcher isn't accidentally locked on a single axis or sign.  History: B7 SIM equivalent reported dx=243/-129 for a 2-px shift; B8.7c v1 already showed the emu path returns the textbook answer for a constant +1 pan; B8.7d extends that to varied 2D motion.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_flowest
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_flowest.log

$scene_2d_0?=@emu/output/scenes/scene_2d_0.bin
$scene_2d_1?=@emu/output/scenes/scene_2d_1.bin
$scene_2d_2?=@emu/output/scenes/scene_2d_2.bin
$scene_2d_3?=@emu/output/scenes/scene_2d_3.bin
$scene_2d_4?=@emu/output/scenes/scene_2d_4.bin
$scene_2d_5?=@emu/output/scenes/scene_2d_5.bin

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

# Boot + both tasks ready.
emulation RunFor "3s"

# Per-frame: write the next scene at g_frame_buffer, fire CONTROL.ARM, wait
# for Stage1Task to finish the SAD brute force and Stage2Task to log.
# 1.0s of emulated time per frame is comfortably above the SAD compute
# budget (121 candidates * 484 pixels * 2 ops ~ 120 kops/frame).

# F1 absolute (0, 0) - prime, no prev yet -> dx=0, dy=0.
sysbus LoadBinary $scene_2d_0 `sysbus GetSymbolAddress "g_frame_buffer"`
sysbus WriteDoubleWord 0x40900010 0x1
emulation RunFor "1.0s"

# F2 absolute (+2, 0) - delta from F1: (+2, 0).
sysbus LoadBinary $scene_2d_1 `sysbus GetSymbolAddress "g_frame_buffer"`
sysbus WriteDoubleWord 0x40900010 0x1
emulation RunFor "1.0s"

# F3 absolute (+2, +2) - delta from F2: (0, +2).
sysbus LoadBinary $scene_2d_2 `sysbus GetSymbolAddress "g_frame_buffer"`
sysbus WriteDoubleWord 0x40900010 0x1
emulation RunFor "1.0s"

# F4 absolute (-1, +1) - delta from F3: (-3, -1).
sysbus LoadBinary $scene_2d_3 `sysbus GetSymbolAddress "g_frame_buffer"`
sysbus WriteDoubleWord 0x40900010 0x1
emulation RunFor "1.0s"

# F5 absolute (-1, -2) - delta from F4: (0, -3).
sysbus LoadBinary $scene_2d_4 `sysbus GetSymbolAddress "g_frame_buffer"`
sysbus WriteDoubleWord 0x40900010 0x1
emulation RunFor "1.0s"

# F6 absolute (+3, -2) - delta from F5: (+4, 0).
sysbus LoadBinary $scene_2d_5 `sysbus GetSymbolAddress "g_frame_buffer"`
sysbus WriteDoubleWord 0x40900010 0x1
emulation RunFor "1.5s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_flowest PC:"
cpu PC
echo "sentai_emu_flowest boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_flowest heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_flowest irq_count:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_irq_count"`
echo "sentai_emu_flowest stage1_processed:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_stage1_processed"`
echo "sentai_emu_flowest stage2_consumed:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_stage2_consumed"`
echo "sentai_emu_flowest pipeline_errors:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_pipeline_errors"`
echo "sentai_emu_flowest last_dx:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_dx"`
echo "sentai_emu_flowest last_dy:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_dy"`
echo "sentai_emu_flowest last_sad:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_sad"`
echo "sentai_emu_flowest last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
