:name: SentAI B8 ARM REPL TPU low-level timing
:description: Boots the staged FileX NAND image, imports /mission.py, measures FS->memory load and per-invoke SendParameters/SendInputs/SendInstructions/GetOutputs/ReadEvent stats through the persistent physical Coral bridge.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_tpu_timing_repl
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_tpu_timing_repl.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

emulation RunFor "7.0s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_tpu_timing_repl PC:"
cpu PC
echo "sentai_emu_tpu_timing_repl boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_tpu_timing_repl heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_tpu_timing_repl repl_lines:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_repl_lines"`
echo "sentai_emu_tpu_timing_repl last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
