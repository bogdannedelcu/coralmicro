:name: SentAI B8.8 P5a Renode Coral MMIO enumeration probe
:description: Boot the EdgeTPU MMIO enumeration probe.  The Renode `coral_usb` provider exposes Coral descriptors and raises IRQ 95; firmware consumes the MMIO event and routes it through UsbHostTask -> EdgeTpuTask.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_edgetpu_mmio_enum_probe
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_edgetpu_mmio_enum_probe.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

# Coral descriptor block (emu/renode/sentai_rt1176.repl `coral_usb`).
# 0x00 STATUS, 0x04 VID/PID, 0x08 iface, 0x0c..0x14 endpoints,
# 0x18 max packets, 0x1c sequence.
sysbus WriteDoubleWord 0x40900100 0x0
sysbus WriteDoubleWord 0x40900104 0x18D19302
sysbus WriteDoubleWord 0x40900108 0x000003FF
sysbus WriteDoubleWord 0x4090010C 0x01020081
sysbus WriteDoubleWord 0x40900110 0x01020202
sysbus WriteDoubleWord 0x40900114 0x01034083
sysbus WriteDoubleWord 0x40900118 0x00400200
sysbus WriteDoubleWord 0x4090011C 0x0

emulation RunFor "500ms"

echo "sentai_emu_edgetpu_mmio_enum_probe pre_attach_boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_edgetpu_mmio_enum_probe pre_attach_step:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_step"`
echo "sentai_emu_edgetpu_mmio_enum_probe pre_attach_heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`

# Synthetic attach on the Renode-side Coral provider.  The firmware polls
# STATUS, reads descriptor registers, and calls the real USB host callback
# chain.
sysbus WriteDoubleWord 0x4090011C 0x1
sysbus WriteDoubleWord 0x40900100 0x1

emulation RunFor "2500ms"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_edgetpu_mmio_enum_probe PC:"
cpu PC
echo "sentai_emu_edgetpu_mmio_enum_probe boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_edgetpu_mmio_enum_probe step:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_step"`
echo "sentai_emu_edgetpu_mmio_enum_probe heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_edgetpu_mmio_enum_probe last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
