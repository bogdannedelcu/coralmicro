:name: SentAI B8 ARM MicroPython sentai.fs over FileX/LevelX
:description: Boots sentai_emu_fs_repl, runs a MicroPython sentai.fs smoke against production FileX/LevelX over the emulated raw NAND backend.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_fs_repl
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_fs_repl.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset
emulation RunFor "3.0s"
lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_fs_repl PC:"
cpu PC
echo "sentai_emu_fs_repl boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_fs_repl heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_fs_repl repl_lines:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_repl_lines"`
echo "sentai_emu_fs_repl last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
echo "sentai_emu_fs_repl fs_smoke_ok:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_fs_smoke_ok"`
echo "sentai_emu_fs_repl fs_smoke_size:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_fs_smoke_size"`
