:name: SentAI B8 ARM REPL TPU persistent session FPS
:description: Boots the staged FileX NAND image, imports /mission.py, loads the cat image into guest memory, starts a persistent host Coral session, and benchmarks per-frame invokes through that session.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_tpu_fps_mem_session_repl
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_tpu_fps_mem_session_repl.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

emulation RunFor "5.0s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_tpu_fps_mem_session_repl PC:"
cpu PC
echo "sentai_emu_tpu_fps_mem_session_repl boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_tpu_fps_mem_session_repl heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_tpu_fps_mem_session_repl repl_lines:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_repl_lines"`
echo "sentai_emu_tpu_fps_mem_session_repl last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
