gpt1: Timers.IMX_GPTimer @ sysbus 0x400EC000
    IRQ -> nvic@119

lpi2c5: Python.PythonPeripheral @ sysbus 0x40C34000
    size: 0x4000
    initable: true
    filename: "scripts/pydev/flipflop.py"

lpi2c6: Python.PythonPeripheral @ sysbus 0x40C38000
