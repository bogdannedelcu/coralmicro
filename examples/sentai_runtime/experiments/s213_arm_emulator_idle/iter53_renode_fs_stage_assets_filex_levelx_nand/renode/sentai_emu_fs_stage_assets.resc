:name: SentAI B8 ARM FileX asset staging
:description: Formats the emulated user NAND and stages model/image/mission files from host through guest FxUser/FileX.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_fs_stage_assets
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_fs_stage_assets.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset
emulation RunFor "120.0s"
lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_fs_stage_assets PC:"
cpu PC
echo "sentai_emu_fs_stage_assets boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_fs_stage_assets heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_fs_stage_assets last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
echo "sentai_emu_fs_stage_assets stage_files:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_stage_files"`
echo "sentai_emu_fs_stage_assets stage_bytes:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_stage_bytes"`
echo "sentai_emu_fs_stage_assets stage_errors:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_stage_errors"`
echo "sentai_emu_fs_stage_assets stage_checksum:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_stage_checksum"`
echo "sentai_emu_fs_stage_assets fx_reads:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_fx_reads"`
echo "sentai_emu_fs_stage_assets fx_writes:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_fx_writes"`
echo "sentai_emu_fs_stage_assets fx_erases:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_fx_erases"`
echo "sentai_emu_fs_stage_assets fx_errors:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_fx_errors"`
