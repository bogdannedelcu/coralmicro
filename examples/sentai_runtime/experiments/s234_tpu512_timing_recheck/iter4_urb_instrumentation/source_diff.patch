+    memcpy(data + 9, &z, 4);
+    memcpy(data + 13, &qx, 4);
+    memcpy(data + 17, &qy, 4);
+    memcpy(data + 21, &qz, 4);
+    memcpy(data + 25, &qw, 4);
+    return sentai_crazy_send_crtp(/*port=*/6, /*channel=*/1, data, 29);
