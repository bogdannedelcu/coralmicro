>>> import sentai

>>> exec('\ndef _tc(nframes, nb):\n    import sentai\n    out = []\n    bands = nb + 2\n    for _ in range(nframes):\n        r = sentai.camera.peek_col(40)\n        col = r[2]\n        n = len(col)\n        bh = n // bands\n        vals = []\n        for i in range(bands):\n            a = i * bh + bh // 5\n            b = (i + 1) * bh - bh // 5\n            s = 0\n            for k in range(a, b):\n                s += col[k]\n            vals.append(s // (b - a))\n        out.append((r[4], r[0], r[1], r[3], vals))\n    return out\n')

