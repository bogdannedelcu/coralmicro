:name: SentAI S230 ARM-emulator sentai.camera + sentai.markers
:description: Boots MicroPython sentai.camera/sentai.markers, loads a staged WhyCon BMP through virtual camera, and verifies detect_from_camera.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_camera_markers_repl
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_camera_markers.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
runMacro $reset

emulation RunFor "20s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_camera_markers PC:"
cpu PC
echo "sentai_emu_camera_markers boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_camera_markers heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_camera_markers last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
echo "sentai_emu_camera_markers repl_lines:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_repl_lines"`
