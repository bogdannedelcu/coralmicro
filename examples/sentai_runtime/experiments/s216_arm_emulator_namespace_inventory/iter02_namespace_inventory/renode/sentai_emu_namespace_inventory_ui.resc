:name: SentAI B9/s216 namespace inventory with UART UI
:description: Same as sentai_emu_namespace_inventory.resc, but opens the LPUART6 analyzer so the inventory is visible live in Renode UI.

i @emu/renode/sentai_rt1176.repl

$bin?=@build_emu/emu/sentai_emu_namespace_inventory
$uart_log?=@/home/bogdan/work/coralmicro/emu/output/sentai_emu_namespace_inventory.log

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x800
"""

lpuart6 CreateFileBackend $uart_log
showAnalyzer lpuart6
runMacro $reset

emulation RunFor "3.0s"

lpuart6 CloseFileBackend $uart_log

echo "sentai_emu_namespace_inventory PC:"
cpu PC
echo "sentai_emu_namespace_inventory boot_state:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_boot_state"`
echo "sentai_emu_namespace_inventory heartbeat:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_heartbeat"`
echo "sentai_emu_namespace_inventory repl_lines:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_repl_lines"`
echo "sentai_emu_namespace_inventory last_tick:"
sysbus ReadDoubleWord `sysbus GetSymbolAddress "g_sentai_emu_last_tick"`
