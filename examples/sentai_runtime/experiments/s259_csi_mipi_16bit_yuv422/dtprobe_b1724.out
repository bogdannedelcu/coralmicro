-- disable YUV422_8BIT payload
fps 0.0 (0 => the stream is tagged 0x1E)

-- 0x4814 <- 0x22 (RGB565) with YUV422 disabled
   wr WR 0 rd RD 0x22
   fps 0.0
    RGB565: no frame (0 B)

-- 0x4814 <- 0x24 (RGB888) with YUV422 disabled
   wr WR 0 rd RD 0x24
   fps 0.0
    RGB888: no frame (0 B)

-- 0x4814 <- 0x30 (UDEF30) with YUV422 disabled
   wr WR 0 rd RD 0x30
   fps 0.0
    UDEF30: no frame (0 B)

-- restore payload enable; 0x4814 back to 0x2A
fps 34.5

