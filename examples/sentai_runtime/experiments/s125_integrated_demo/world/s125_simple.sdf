<?xml version="1.0" ?>
<!--
  s125_simple.sdf — MINIMAL world for step-by-step bring-up.

  No bootstrap planes, no backdrop, no black fallback.  Just:
    - 25×25 m ground plane with Harmonic 4K texture (visible terrain)
    - 4 ArUco panels (ids 0..3) raised to z=0.05 m so they sit above
      the floor when drone hovers at 2 m (camera will see them clearly)
    - Sun light
    - PIP widget for down-cam topic so operator can watch the camera

  This is the minimal-aggressor world: no extra physics objects to
  load gz's render thread.  Target: stable 2 m hover + ArUco markers
  visible in drone camera.
-->
<sdf version="1.9">
  <world name="s125_simple">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Contact' filename='libgz-sim-contact-system.so'/>
    <plugin name='gz::sim::systems::Imu' filename='libgz-sim-imu-system.so'/>
    <plugin name='gz::sim::systems::AirPressure' filename='libgz-sim-air-pressure-system.so'/>
    <plugin name='gz::sim::systems::Sensors' filename='libgz-sim-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen='0'>
      <plugin name='3D View' filename='MinimalScene'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.85 1.0</background_color>
        <camera_pose>-4 -4 5 0 0.6 0.785</camera_pose>
      </plugin>
      <plugin filename='GzSceneManager'/>
      <plugin filename='EntityContextMenuPlugin'/>
      <plugin filename='InteractiveViewControl'/>
      <plugin filename='CameraTracking'/>
      <plugin filename='MarkerManager'/>
      <plugin filename='SelectEntities'/>
      <plugin filename='Spawn'/>
      <plugin filename='VisualizationCapabilities'/>
      <plugin filename='WorldControl'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>72</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='left' target='left'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <!-- PIP: cf2 down-cam — operator-facing visual confirmation -->
      <plugin filename='ImageDisplay' name='Image Display'>
        <gz-gui>
          <title>cf2 downward_cam (PIP)</title>
          <property type='bool' key='showTitleBar'>1</property>
          <property type='string' key='state'>floating</property>
          <property type='double' key='width'>320</property>
          <property type='double' key='height'>240</property>
          <property type='double' key='x'>10</property>
          <property type='double' key='y'>10</property>
        </gz-gui>
        <topic>/downward_cam/image</topic>
        <topic_picker>true</topic_picker>
      </plugin>
    </gui>

    <wind><linear_velocity>0 0 0</linear_velocity></wind>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <grid>false</grid>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.85 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 -0.5 -0.8</direction>
    </light>

    <!-- Ground plane with Harmonic 4K texture, 25×25 m -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>25 25</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>25 25</size></plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/harmonic_alt200_4k.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4 ArUco markers (4x4_50 ids 0..3) at z=0.05 m, in a 0.8 m
         square around origin.  At z=0.05 they're well above the cf2's
         resting camera position (which would otherwise be below ground)
         and clearly visible from the drone at 2 m altitude. -->
    <model name="aruco_id0">
      <static>true</static>
      <pose>0.4 0.4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>materials/textures/aruco_4x4_50_id0.png</albedo_map>
              <metalness>0</metalness><roughness>1</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="aruco_id1">
      <static>true</static>
      <pose>-0.4 0.4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>materials/textures/aruco_4x4_50_id1.png</albedo_map>
              <metalness>0</metalness><roughness>1</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="aruco_id2">
      <static>true</static>
      <pose>-0.4 -0.4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>materials/textures/aruco_4x4_50_id2.png</albedo_map>
              <metalness>0</metalness><roughness>1</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="aruco_id3">
      <static>true</static>
      <pose>0.4 -0.4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>materials/textures/aruco_4x4_50_id3.png</albedo_map>
              <metalness>0</metalness><roughness>1</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
