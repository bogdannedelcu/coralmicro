static const char b64_table[] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

static mp_obj_t mod_sentai_fs_read_base64(mp_obj_t path_obj) {
    _fs_check_usb();
    const char* path = mp_obj_str_get_str(path_obj);
    int size = sentai_fs_size(path);
    if (size < 0) {
        mp_raise_msg(&mp_type_OSError, (mp_rom_error_text_t)"file not found");
    }
    uint8_t* buf = ((uint8_t *)(m_malloc(sizeof(uint8_t) * (size))));
    int n = sentai_fs_read(path, buf, size);
    if (n <= 0) {
        ((void)(size), m_free(buf));
        mp_raise_msg(&mp_type_OSError, (mp_rom_error_text_t)"read error");
    }

    int b64_len = ((n + 2) / 3) * 4;
    char* b64 = ((char *)(m_malloc(sizeof(char) * (b64_len + 1))));
    int j = 0;
    for (int i = 0; i < n; i += 3) {
        uint32_t a = buf[i];
        uint32_t b = (i + 1 < n) ? buf[i + 1] : 0;
        uint32_t c = (i + 2 < n) ? buf[i + 2] : 0;
        uint32_t triple = (a << 16) | (b << 8) | c;
        b64[j++] = b64_table[(triple >> 18) & 0x3F];
        b64[j++] = b64_table[(triple >> 12) & 0x3F];
        b64[j++] = (i + 1 < n) ? b64_table[(triple >> 6) & 0x3F] : '=';
        b64[j++] = (i + 2 < n) ? b64_table[triple & 0x3F] : '=';
    }
    b64[j] = '\0';
    ((void)(size), m_free(buf));

    for (int i = 0; i < j; i += 76) {
        int chunk = (j - i > 76) ? 76 : (j - i);
        sentai_console_write(b64 + i, chunk);
        sentai_console_write("\r\n", 2);
    }
    mp_obj_t result = mp_obj_new_str(b64, j);
    ((void)(b64_len + 1), m_free(b64));
    return result;
}
static const mp_obj_fun_builtin_fixed_t mod_sentai_fs_read_base64_obj = {{&mp_type_fun_builtin_1}, .fun._1 = mod_sentai_fs_read_base64};



