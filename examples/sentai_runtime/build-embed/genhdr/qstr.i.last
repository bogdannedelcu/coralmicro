        mp_raise_msg(&mp_type_OSError,
            (mp_rom_error_text_t)"REPL must be on USB: call sentai.console('usb')");
    }
    if (sentai_mesh_is_running()) {
        mp_raise_msg(&mp_type_OSError,
            (mp_rom_error_text_t)"mesh is running: call sentai.mesh.stop() first");
    }
    return mp_obj_new_int(sentai_link_init(baudrate, sysid, compid));
}
